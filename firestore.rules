rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /programaciones/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /docentes/{teacherId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /supervisionPlanes/{planId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
